{
  "owners": {
    "m1": { "name": "Member 1 - Frontend & UX", "paths": [
      "apps/web/**"
    ]},
    "m2": { "name": "Member 2 - AI Agent", "paths": [
      "apps/api/src/services/ai/**",
      "apps/api/tests/ai/**",
      "apps/api/fixtures/quotes/**",
      "apps/api/prisma/schema/risk-recommendation.prisma",
      "packages/shared/src/ai/**",
      "docs/ai-provider.md"
    ]},
    "m3": { "name": "Member 3 - Core & Procurement Engine", "paths": [
      "apps/api/src/app.ts",
      "apps/api/src/server.ts",
      "apps/api/src/routes/index.ts",
      "apps/api/src/routes/requests.ts",
      "apps/api/src/routes/quotes.ts",
      "apps/api/src/routes/analysis.ts",
      "apps/api/src/routes/approval.ts",
      "apps/api/src/controllers/requests.controller.ts",
      "apps/api/src/controllers/quotes.controller.ts",
      "apps/api/src/controllers/analysis.controller.ts",
      "apps/api/src/controllers/approval.controller.ts",
      "apps/api/src/middleware/**",
      "apps/api/src/utils/**",
      "apps/api/src/schemas/**",
      "apps/api/src/services/procurement/**",
      "apps/api/src/services/intake/**",
      "apps/api/prisma/migrations/**",
      "apps/api/prisma/seed.ts",
      "apps/api/prisma/schema/base.prisma",
      "apps/api/prisma/schema/request.prisma",
      "apps/api/prisma/schema/vendor-quote.prisma",
      "apps/api/prisma/schema/approval.prisma",
      "apps/api/tests/procurement/**",
      "apps/api/tests/routes/**",
      "apps/api/tests/helpers/**",
      "apps/api/uploads/**",
      "apps/api/tsconfig.json",
      "packages/shared/src/index.ts",
      "packages/shared/src/request/**",
      "packages/shared/src/quote/**",
      "packages/shared/src/approval/**",
      "tsconfig.base.json",
      "package.json",
      "docs/api.md"
    ]},
    "m4": { "name": "Member 4 - PayPal, Integration & DevOps", "paths": [
      "apps/api/src/services/paypal/**",
      "apps/api/src/routes/payments.ts",
      "apps/api/src/routes/webhooks.ts",
      "apps/api/src/controllers/payments.controller.ts",
      "apps/api/src/controllers/webhooks.controller.ts",
      "apps/api/prisma/schema/payment.prisma",
      "apps/api/prisma/schema/webhook.prisma",
      "apps/api/tests/paypal/**",
      "apps/api/fixtures/paypal-samples/**",
      "packages/shared/src/payment/**",
      ".github/**",
      "scripts/**",
      "postman/**",
      "render.yaml",
      ".env.example",
      ".gitignore",
      "README.md",
      "CONTRIBUTING.md",
      "FOLDER_STRUCTURE.md",
      "OWNERS.json",
      "docs/architecture.md",
      "docs/payments.md",
      "docs/deployment.md",
      "docs/demo-script.md",
      "docs/paypal-spike.md",
      "docs/samples/**"
    ]}
  },
  "open": [
    "package-lock.json",
    "apps/*/package.json",
    "packages/*/package.json",
    "**/OWNER.md",
    "**/.gitkeep"
  ]
}
