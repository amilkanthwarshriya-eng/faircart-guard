{
  "info": { "name": "FairCart Guard - Member 4 payments", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "requestId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "paymentId", "value": "" }
  ],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Create PayPal order", "event": [{ "listen": "test", "script": { "exec": [
        "const j = pm.response.json();", "pm.test('201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('paymentId', j.id);", "console.log('Open in browser and approve as the sandbox buyer:', j.approvalUrl);" ] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/payments/create-order", "body": { "mode": "raw", "raw": "{ \"requestId\": \"{{requestId}}\" }" } } },
    { "name": "Capture order (after buyer approval)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/payments/capture-order", "body": { "mode": "raw", "raw": "{ \"paymentId\": \"{{paymentId}}\" }" } } },
    { "name": "Get payment", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/{{paymentId}}" } },
    { "name": "Cancel payment", "request": { "method": "POST", "url": "{{baseUrl}}/api/payments/{{paymentId}}/cancel" } }
  ]
}
