{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@faircart/shared": ["../../packages/shared/src/index"]
    },
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src", "tests", "prisma/seed.ts", "vitest.config.ts"]
}
